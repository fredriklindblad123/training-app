NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Krävs av web/api/index.py (Garmin-synk). Sätts som vanliga Environment
# Variables i Vercel-projektet (delas mellan Node- och Python-funktionerna),
# och lokalt här om du kör `vercel dev` för att testa Python-endpointen.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Delad hemlighet mellan Next.js-servern och Python-funktionerna, så att
# /api/garmin/login och /api/garmin/sync inte kan anropas av utomstående.
# Generera t.ex. med: openssl rand -hex 32
INTERNAL_API_SECRET=

# Vercel skickar automatiskt "Authorization: Bearer <CRON_SECRET>" på det
# schemalagda anropet i vercel.json om denna är satt i projektets
# miljövariabler. Generera t.ex. med: openssl rand -hex 32
CRON_SECRET=
