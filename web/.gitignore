# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# Oankrat mönster med flit. `/.next/` matchar bara web/-roten, och en
# dev-server som startats från fel katalog (t.ex. web/src) lägger sin
# byggcache där i stället — blind fläck. Det hände 2026-09-14 och 112
# artefaktfiler hann checkas in innan det upptäcktes.
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
